APP_ENV=local
SECRETS_PROVIDER=reference
SECRETS_NAMESPACE_PREFIX=fbr/blogs
EASYPANEL_API_URL=
EASYPANEL_API_TOKEN=
BLOG_LOCAL_DATA_PATH=.data/fbr-blogs.json
# Public frontend values (never place private keys here)
NEXT_PUBLIC_APP_NAME=Nome do Blog
NEXT_PUBLIC_SUPABASE_URL=@url:`https://supabase-control-tower-api.fbr.news`
NEXT_PUBLIC_SUPABASE_ANON_KEY=<secret-manager:fbr/blogs/<PROJECT_ID>/NEXT_PUBLIC_SUPABASE_ANON_KEY>
# Server/runtime values: inject via Easypanel Secret Manager
SUPABASE_URL=@url:`https://supabase-control-tower-api.fbr.news`
SUPABASE_SERVICE_ROLE_KEY=<secret-manager:fbr/blogs/<PROJECT_ID>/SUPABASE_SERVICE_ROLE_KEY>
CONTROL_TOWER_PROJECT_ID=<PROJECT_ID>
CONTROL_TOWER_SCHEMA_NAME=<SCHEMA_NAME>
BLOG_SCHEMA=<SCHEMA_NAME>
CONTROL_TOWER_API_URL=
CONTROL_TOWER_API_KEY=
CONTROL_TOWER_ORGANIZATION_SLUG=gestaodb
CONTROL_TOWER_HANDOFF_BASE_URL=
CONTROL_TOWER_HANDOFF_PATH_TEMPLATE=
HERMES_API_URL=
HERMES_API_KEY=
HERMES_CREATE_PATH=
HERMES_HEALTH_PATH_TEMPLATE=
HERMES_CLI_COMMAND=
FBR_ADS_API_URL=
FBR_ADS_API_KEY=
FBR_ADS_INVENTORY_PATH=
FBR_ADS_CREATIVE_PATH=
